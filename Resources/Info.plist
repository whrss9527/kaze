<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Proxi</string>
	<key>CFBundleExecutable</key>
	<string>Proxi</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<!-- 改名前就用这个标识，保持不变：系统授权、登录项、通知和一键更新都认它。 -->
	<key>CFBundleIdentifier</key>
	<string>com.whrss9527.proxyswitch</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- 界面有英文和简体中文（Resources/*.lproj），设置 → 通用里可以选。 -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh-Hans</string>
	</array>
	<key>CFBundleName</key>
	<string>Proxi</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>__VERSION__</string>
	<key>CFBundleVersion</key>
	<string>__BUILD__</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Proxi 命令</string>
			<!-- proxyswitch:// 是改名前的写法，快捷指令和脚本里用着的照样能用。 -->
			<key>CFBundleURLSchemes</key>
			<array>
				<string>proxi</string>
				<string>proxyswitch</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- 更新流程的测试用本机 HTTP 服务器当发布源（PROXI_UPDATE_URL）。 -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- 中文的写在 Resources/zh-Hans.lproj/InfoPlist.strings。 -->
	<key>NSLocationUsageDescription</key>
	<string>Switching by network needs to read the name of the connected Wi‑Fi, which macOS treats as location information. Proxi doesn't read or store your location.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Switching by network needs to read the name of the connected Wi‑Fi, which macOS treats as location information. Proxi doesn't read or store your location.</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>GPL-3.0 License</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>
</dict>
</plist>
